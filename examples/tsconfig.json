{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "typeRoots": ["../ts/node_modules/@types"],
    "types": ["node"]
  },
  "include": ["*.ts"]
}
