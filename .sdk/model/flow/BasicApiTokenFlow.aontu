# BasicApiTokenFlow

main: kit: flow: BasicApiTokenFlow:
{
  entity: "api_token",
  kind: "basic",
  name: "BasicApiTokenFlow",
  step: [
    {
      i: {
        ref: "api_token_ref01"
      }

      m: {
        organization_slug: "organization_slug01",
        token_name: "token_name01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "api_token_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "api_token_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "api_token01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "api_token_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicApiTokenFlow"
}