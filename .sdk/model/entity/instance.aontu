# Entity: instance

main: kit: entity: instance: {

  alias: field: {}

  fields: {
    hostname: {
      h: "Hostname"
      n: "hostname"
      r: false
      sh: "The DNS hostname used for client libSQL and HTTP connections (specific to this instance only)."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the instance (location code)."
      t: "`$STRING`"
    }
    region: {
      h: "Region"
      n: "region"
      r: false
      sh: "The location code for the region this instance is located."
      t: "`$STRING`"
    }
    type: {
      h: "Type"
      n: "type"
      r: false
      sh: "The type of database instance this, will be `primary` or `replica`."
      t: "`$STRING`"
    }
    uuid: {
      h: "Uuid"
      n: "uuid"
      r: false
      sh: "The instance universal unique identifier (UUID)."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "instance"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/organizations/{organizationSlug}/databases/{databaseName}/instances"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "database_name"
                or: "databaseName"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "organization_id"
                or: "organizationSlug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/organizations/{organizationSlug}/databases/{databaseName}/instances"
          q: {
            exist: [
              "database_name"
              "organization_id"
            ]
          }
          r: {
            param: {
              databaseName: "database_name"
              organizationSlug: "organization_id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "organizations"
            }
            {
              var: "organization_id"
            }
            {
              lit: "databases"
            }
            {
              var: "database_name"
            }
            {
              lit: "instances"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.instances`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/organizations/{organizationSlug}/databases/{databaseName}/instances/{instanceName}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "database_name"
                or: "databaseName"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "id"
                or: "instanceName"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "organization_id"
                or: "organizationSlug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/organizations/{organizationSlug}/databases/{databaseName}/instances/{instanceName}"
          q: {
            exist: [
              "database_name"
              "id"
              "organization_id"
            ]
          }
          r: {
            param: {
              databaseName: "database_name"
              instanceName: "id"
              organizationSlug: "organization_id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "organizations"
            }
            {
              var: "organization_id"
            }
            {
              lit: "databases"
            }
            {
              var: "database_name"
            }
            {
              lit: "instances"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.instance`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.organization") path("$.main.kit.entity.database")]
  ]

}
