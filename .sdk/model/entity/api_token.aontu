          m: "GET"
          o: "/v1/auth/api-tokens"
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "auth"
            }
            {
              lit: "api-tokens"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.tokens`"
          }
        }
      ]
    }
    remove: {
      name: "remove"
      points: [
        {
          co: {
            id: "DELETE /v1/organizations/{organizationSlug}/api-tokens/{tokenId}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                ex: "clGFZ4STEe6fljpFzIum8A"
                k: "param"
                n: "id"
                or: "tokenId"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "organization_slug"
                or: "organizationSlug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "DELETE"
          o: "/v1/organizations/{organizationSlug}/api-tokens/{tokenId}"
          q: {
            exist: [
              "id"
              "organization_slug"
            ]
          }
          r: {
            param: {
              organizationSlug: "organization_slug"
              tokenId: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
