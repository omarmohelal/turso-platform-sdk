# Entity: api_token

main: kit: entity: api_token: {

  alias: field: {}

  fields: {
    created_at: {
      h: "Created At"
      n: "created_at"
      r: false
      sh: "The date the token was created."
      t: "`$STRING`"
    }
    group: {
      h: "Group"
      n: "group"
      r: false
      sh: "The group name (inside `organization`) to restrict this token to."
      t: "`$STRING`"
    }
    id: {
      h: "Id"
      n: "id"
      r: false
      sh: "The ID generated by Turso for the API Token."
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name given to the API Token."
      t: "`$STRING`"
    }
    organization: {
      h: "Organization"
      n: "organization"
      r: false
      sh: "The organization slug to restrict this token to."
      t: "`$STRING`"
    }
    owner: {
      h: "Owner"
      n: "owner"
      r: false
      sh: "The user who minted the token."
      t: "`$OBJECT`"
    }
    scopes: {
      h: "Scopes"
      n: "scopes"
      r: false
      sh: "Permissions to grant a group-scoped token."
      t: "`$ARRAY`"
    }
    token: {
      h: "Token"
      n: "token"
      r: false
      sh: "The actual token contents as a JWT."
      t: "`$STRING`"
    }
  }

  id: {
    field: "id"
    name: "id"
  }

  name: "api_token"
  op: {
    create: {
      name: "create"
      points: [
        {
          bf: [
            "group"
            "organization"
            "scopes"
          ]
          co: {
            id: "POST /v1/auth/api-tokens/{tokenName}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "tokenName"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "POST"
          o: "/v1/auth/api-tokens/{tokenName}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              tokenName: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "auth"
            }
            {
              lit: "api-tokens"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /v1/organizations/{organizationSlug}/api-tokens"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "organization_slug"
                or: "organizationSlug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/organizations/{organizationSlug}/api-tokens"
          q: {
            exist: [
              "organization_slug"
            ]
          }
          r: {
            param: {
              organizationSlug: "organization_slug"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "organizations"
            }
            {
              var: "organization_slug"
            }
            {
              lit: "api-tokens"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.tokens`"
          }
        }
        {
          co: {
            id: "GET /v1/auth/api-tokens"
            source: "openapi3"
            version: 2
