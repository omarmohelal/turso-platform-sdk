            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "organizations"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /v1/organizations/{organizationSlug}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "organizationSlug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/v1/organizations/{organizationSlug}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              organizationSlug: "id"
            }
          }
          rs: {
            kind: "json"
            media: "application/json"
          }
          s: [
            {
              lit: "v1"
            }
            {
              lit: "organizations"
            }
            {
              var: "id"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.organization`"
          }
        }
      ]
    }
    update: {
      name: "update"
      points: [
        {
          bf: [
            "overages"
            "require_mfa"
            "restore_enabled"
          ]
          co: {
            id: "PATCH /v1/organizations/{organizationSlug}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "organizationSlug"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "PATCH"
          o: "/v1/organizations/{organizationSlug}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
