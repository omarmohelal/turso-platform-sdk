# Entity: database_configuration

main: kit: entity: database_configuration: {

  alias: field: {}

  fields: {
    allow_attach: {
      de: true
      h: "Allow Attach"
      n: "allow_attach"
      r: false
      sh: "Allow or disallow attaching databases to the current database."
      t: "`$BOOLEAN`"
    }
